API_INTERNAL_KEY=your-internal-api-key

GOOGLE_APPLICATION_CREDENTIALS=/app/var/secrets/google-drive/musicplayer-api-3abee89ba528.json
GOOGLE_DRIVE_FOLDER_ID=1uaIrMoQw3d-KIh6w0M-QRviPrlr2Xeod

DOWNLOAD_DIRECTORY=/app/var/downloads