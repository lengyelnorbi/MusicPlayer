{
  "expo": {
    "name": "My Music",
    "slug": "my-music",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sandboxmusicplayer",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SandboxMusicPlayer"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b12"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
