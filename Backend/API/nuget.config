<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Increase HTTP request timeout from default 100 seconds to 300 seconds -->
    <add key="httpRequestTimeout" value="300" />
  </config>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
